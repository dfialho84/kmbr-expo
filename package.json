{
  "name": "kmbr-expo",
  "version": "0.1.0",
  "description": "Mobile app desenvolvido com React Native + Expo",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx && npm run check:no-network-sdks",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "check:no-network-sdks": "node -e \"const pkg=require('./package.json');const banned=['axios','firebase','@firebase/app','supabase','@supabase/supabase-js'];const found=banned.filter(b=>pkg.dependencies?.[b]||pkg.devDependencies?.[b]);if(found.length){console.error('Banned network SDKs found:',found);process.exit(1);}console.log('No banned network SDKs found.')\"",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "detox:test:android": "detox test --configuration android.emu.debug",
    "detox:test:ios": "detox test --configuration ios.sim.debug",
    "detox:test:ios:feature": "detox test --configuration ios.sim.debug e2e/features",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.4",
    "expo-file-system": "~56.0.0",
    "expo-router": "~56.2.0",
    "expo-secure-store": "~56.0.0",
    "expo-sqlite": "~56.0.0",
    "expo-status-bar": "~56.0.4",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.2",
    "zod": "^3.22.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@cucumber/cucumber": "^9.5.1",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.8",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~56.0.0",
    "better-sqlite3": "^12.10.0",
    "detox": "^20.50.4",
    "detox-cli": "^20.50.4",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-expo": "^56.0.4",
    "prettier": "^3.1.0",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
