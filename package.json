{
  "name": "kmbr-expo",
  "version": "0.1.0",
  "description": "Mobile app desenvolvido com React Native + Expo",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo prebuild",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "detox:test:android": "detox test --configuration android.emu.debug",
    "detox:test:ios": "detox test --configuration ios.sim.debug",
    "detox:test:ios:feature": "detox test --configuration ios.sim.debug e2e/features",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-router": "^3.4.8",
    "expo-sqlite": "^14.0.0",
    "expo-secure-store": "^13.0.0",
    "expo-file-system": "^17.0.0",
    "expo-status-bar": "^1.11.1",
    "react": "^18.2.0",
    "react-native": "^0.76.0",
    "react-native-web": "^0.19.9",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "nativewind": "^2.0.12",
    "zustand": "^4.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.42",
    "@types/react-native": "^0.73.0",
    "@testing-library/react-native": "^12.4.3",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-nativewind": "^1.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "typescript": "^5.3.2",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-native": "^4.1.1",
    "detox": "^20.13.2",
    "detox-cli": "^20.13.2",
    "@cucumber/cucumber": "^9.5.1",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.1"
  },
  "private": true
}
