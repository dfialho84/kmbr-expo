{
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "types": [
      "jest"
    ],
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@domain/*": [
        "src/domain/*"
      ],
      "@application/*": [
        "src/application/*"
      ],
      "@adapters/*": [
        "src/adapters/*"
      ],
      "@infrastructure/*": [
        "src/infrastructure/*"
      ],
      "@ui/*": [
        "src/ui/*"
      ],
      "@mocks/*": [
        "src/__mocks__/*"
      ]
    }
  },
  "include": [
    "src",
    "global.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__tests__",
    "e2e"
  ],
  "extends": "expo/tsconfig.base"
}
