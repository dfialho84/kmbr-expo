{
  "env": {
    "react-native/react-native": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react-native/all",
    "prettier"
  ],
  "plugins": ["@typescript-eslint", "react-native"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_" }
    ],
    "react-native/no-color-literals": "warn",
    "react-native/no-raw-text": "off"
  },
  "overrides": [
    {
      "files": ["src/domain/**/*.ts", "src/domain/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*/adapters/*", "@adapters/*"],
                "message": "domain/ must not import from adapters/ (constitution rule 14)"
              },
              {
                "group": ["*/infrastructure/*", "@infrastructure/*"],
                "message": "domain/ must not import from infrastructure/ (constitution rule 14)"
              },
              {
                "group": ["*/ui/*", "@ui/*"],
                "message": "domain/ must not import from ui/ (constitution rule 14)"
              },
              {
                "group": ["expo-sqlite", "expo-secure-store", "@react-native-async-storage/*"],
                "message": "domain/ must not import storage libraries directly (constitution rule 15)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/ui/**/*.ts", "src/ui/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["expo-sqlite"],
                "message": "ui/ must not import expo-sqlite directly — use adapters via hooks (ST-1, constitution rule 7)"
              },
              {
                "group": ["expo-secure-store"],
                "message": "ui/ must not import expo-secure-store directly — use adapters via hooks (ST-1, constitution rule 7)"
              },
              {
                "group": ["@react-native-async-storage/*"],
                "message": "ui/ must not import AsyncStorage directly — use adapters via hooks (ST-1, constitution rule 7)"
              }
            ]
          }
        ]
      }
    }
  ]
}
